PORT=5000
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/vapepass
JWT_SECRET=change-me-in-production
JWT_EXPIRES=7d
JWT_REFRESH_SECRET=change-me-in-production-too
JWT_REFRESH_EXPIRES=30d
CLIENT_URL=https://projectclient-zeta.vercel.app
NODE_ENV=production
# Comma-separated hostnames allowed to run the marketing-site demo chatbot
MARKETING_DEMO_HOSTS=projectclient-zeta.vercel.app
# Optional: extra hostnames allowed for embed testing (e.g. staging.example.com)
# EMBED_TEST_HOSTS=

# Email — preferred on Railway (HTTPS; avoids Gmail SMTP timeouts)
RESEND_API_KEY=
# Use a verified Resend domain in production, e.g. VapePass <noreply@yourdomain.com>
# For Resend testing without a domain: VapePass <onboarding@resend.dev>
EMAIL_FROM="VapePass <onboarding@resend.dev>"
# Until a domain is verified, redirect all Resend mail to YOUR Resend account email
# (the address shown in Resend errors), e.g. your Gmail used to sign up for Resend:
RESEND_TESTING_TO=you@gmail.com
# Inbox that receives admin notifications (new subscription activated,
# Request Assistance, Need Help, Contact Us)
SUPPORT_ADMIN_EMAIL=you@gmail.com
# Optional — address shown to customers in email footers (defaults to SUPPORT_ADMIN_EMAIL)
# SUPPORT_CONTACT_EMAIL=support@yourdomain.com
# Optional — footer links in transactional emails (default to CLIENT_URL/docs and /contact)
# DOCS_URL=https://yourdomain.com/docs
# SUPPORT_URL=https://yourdomain.com/contact

# Optional local SMTP fallback (often blocked on Railway → Connection timeout)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Stripe — recurring monthly subscription
# Use sk_test_/whsec_ (test mode) or sk_live_/whsec_ (live mode). The mode is
# implied by the keys; STRIPE_PRICE_ID must belong to the SAME mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
#
# STRIPE_PRICE_ID drives checkout AND the price shown in the app and emails
# (read live from Stripe), so switching prices needs no code change.
#
#   Phase 1 — live payment verification:
#     set STRIPE_PRICE_ID to the LIVE $1/month Price, run one real signup +
#     payment, and confirm the charge lands in the Stripe dashboard.
#   Phase 2 — production pricing:
#     set STRIPE_PRICE_ID to the LIVE $99/month Price and redeploy. Existing
#     subscriptions keep their original Price until migrated in Stripe.
STRIPE_PRICE_ID=
# Display-only fallback in cents, used if the Stripe Price cannot be read
STRIPE_FALLBACK_PRICE_CENTS=9900

# Optional
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# VapePass Assistant (AI chatbot)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SCRAPINGBEE_API_KEY=
CRON_SECRET=change-me-cron-secret
# Public API URL used in embed codes and uploaded asset URLs (no trailing slash)
# Local:  http://localhost:5000
# Production Railway: MUST be your Railway HTTPS origin, e.g.
#   https://your-app.up.railway.app
# If left as localhost in production, the API will still derive the host from
# the incoming request — but set this explicitly so emails/cron stay correct.
API_PUBLIC_URL=https://your-app.up.railway.app
# Set true on long-running hosts to run daily inventory sync in-process
ENABLE_INTERNAL_CRON=false

# Optional — public HTTPS logo URL for emails (Gmail cannot load localhost/SVG)
# EMAIL_LOGO_URL=https://your-cdn.example.com/vapepass-logo.png

